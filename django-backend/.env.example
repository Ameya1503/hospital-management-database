DJANGO_SETTINGS_MODULE=hms.settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local development prints verification emails to the runserver terminal.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@pulse-hms.local
# Production SMTP/SES configuration (set only when replacing console backend).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
POSTGRES_DB=pulse_hms
POSTGRES_USER=pulse_hms_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional AWS private file storage. Leave blank for local development.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Razorpay: use test-mode credentials locally. Keep secrets out of source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional AI-assisted appointment triage. It recommends from existing doctors; it never diagnoses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Development-only validation helper. Leave unset for PostgreSQL.
# DJANGO_USE_EPHEMERAL_SQLITE=true
